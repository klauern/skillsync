{
  "name": "skillsync Dev Container",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "JUST_VERSION": "1.46.0",
      "DELTA_VERSION": "0.18.2"
    }
  },
  "runArgs": ["--cap-add=NET_ADMIN", "--cap-add=NET_RAW"],
  "remoteUser": "dev",
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "golang.go",
        "eamodio.gitlens"
      ],
      "settings": {
        "go.lintTool": "golangci-lint",
        "go.lintFlags": ["--fast"],
        "go.formatTool": "gofumpt",
        "editor.formatOnSave": true,
        "[go]": {
          "editor.defaultFormatter": "golang.go"
        }
      }
    }
  },
  "mounts": [
    "source=skillsync-history-${devcontainerId},target=/commandhistory,type=volume",
    "source=skillsync-claude-${devcontainerId},target=/home/dev/.claude,type=volume",
    "source=${localEnv:HOME}/.claude,target=/home/dev/.claude-host,type=bind,readonly",
    "source=skillsync-gomod-${devcontainerId},target=/home/dev/go/pkg/mod,type=volume",
    "source=skillsync-gobuild-${devcontainerId},target=/home/dev/.cache/go-build,type=volume"
  ],
  "containerEnv": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CONFIG_DIR": "/home/dev/.claude",
    "GOPATH": "/home/dev/go",
    "NODE_OPTIONS": "--max-old-space-size=4096"
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=delegated",
  "workspaceFolder": "/workspace",
  "postCreateCommand": "sudo chown -R dev:dev /home/dev/go/pkg/mod /home/dev/.cache/go-build /home/dev/.claude && bash /workspace/.devcontainer/setup-claude.sh && go mod download",
  "postStartCommand": "sudo /usr/local/bin/init-firewall.sh",
  "waitFor": "postStartCommand"
}
